{
  "$schema": "https://neoxix.ca/schemas/design-tokens.schema.json",
  "version": "1.0.0",
  "name": "Neoxix Design System",
  "description": "Shared design tokens for all Neoxix-Inc repositories.",

  "themes": {
    "default": "neoxix-dark"
  },

  "color": {
    "primary": "#0F62FE",
    "secondary": "#00C2FF",
